# ============================================================
# USIU-Africa Major Advisor — Environment Configuration
# ============================================================

# Flask Mode: 'development' or 'production'
FLASK_ENV=development
FLASK_DEBUG=True

# Application Secret Key
# Generate a strong key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_secure_random_64_character_hex_string

# ------------------------------------------------------------
# Database Configuration (Supabase PostgreSQL)
# ------------------------------------------------------------
# 1. Create a free project at https://supabase.com
# 2. Go to Project Settings -> Database -> Connection String -> URI mode
# 3. Paste the connection URI below (use transaction pooler port 6543 or direct 5432):
# Example:
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# For local development without internet, you can comment DATABASE_URL above to use SQLite:
# DATABASE_URL=sqlite:///instance/site.db

# ------------------------------------------------------------
# Google Gemini AI (Primary Interest Analyzer)
# ------------------------------------------------------------
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
